# Where Neo4j is. This is the whole configuration surface.
#
# There is no user or password: the database runs with authentication
# disabled and bound to loopback (see docker-compose.yml), because a
# credential that never guards anything is a credential to manage, not a
# control. If you ever point this at a database reachable from a network,
# turn authentication back on there and add the auth back in db.py.
NEO4J_URI=bolt://localhost:7687

# Everything else -- the embedding model, batch sizes, response budgets,
# co-change thresholds -- was a setting once. Each was chosen by measurement,
# so each is now a constant beside the code that uses it. Response budgets
# stay adjustable per call, through the MCP tools' budget_tokens argument.
